# frpc 客户端示例配置 —— 把本机棋盘游戏主机端口映射到公网
# 复制为 frpc.toml 后按你的 frps / OpenFrp 面板修改，切勿提交含真实 token 的文件。
#
# 用法（自建 frps）:
#   frpc -c frpc.toml
#
# OpenFrp 用户通常用其客户端 / 启动器，本文件仅作字段参考。

serverAddr = "你的frps公网IP或域名"
serverPort = 7000

# 认证（与 frps 一致）
auth.method = "token"
auth.token = "请替换为你的token"

# 日志（可选）
log.to = "console"
log.level = "info"

# 将本机 8765 (棋盘游戏 listen-server) 映射出去
[[proxies]]
name = "boardgame-ws"
type = "tcp"
localIP = "127.0.0.1"
localPort = 8765
# 远程端口：好友连接 ws://公网IP:remotePort/ws
remotePort = 18765

# 若 frps 启用了 HTTP 虚拟主机，也可用 type = "http" + customDomains，
# 但 WebSocket 走 TCP 映射最简单可靠。
